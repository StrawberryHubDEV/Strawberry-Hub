if not game:IsLoaded() then
    game.Loaded:Wait()
end

local DISCORD = "discord.gg/AH8SRWBxQy"

local PART_1 = {"Sniper Arena", "Bug Evolution", "Home Defense", "Jurassic Blocky", "Primeval Earth"}
local PART_2 = {"Murder Mystery 2", "The Sanctuary", "Backseat Rally", "Prehistoria", "Jurassic Pixel", "Creatures of Sonaria"}

local PLACES = {
    [122446657157717] = 1, [90165746516953] = 1, [70650894743738] = 1, [105527962898452] = 1,
    [11653088948] = 1, [10696301650] = 1,
    [142823291] = 2, [108379405712368] = 2, [94278659624110] = 2, [6686932749] = 2,
    [105667060450408] = 2, [5233782396] = 2,
}

local GAMES = {
    [9534705677] = 1, [10769957062] = 1, [10769857262] = 1, [4130569984] = 1,
    [5591327764] = 2, [10769543742] = 2, [7396714471] = 2, [1831550657] = 2,
}

local function notify(text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {Title = "Strawberry Hub", Text = text, Duration = 10})
    end)
end

local function pickPart()
    local part = PLACES[game.PlaceId] or GAMES[game.GameId]
    if part then return part end
    local ok, isJurassic = pcall(function()
        local ts = game:GetService("ReplicatedStorage"):FindFirstChild("TS")
        local config = ts and ts:FindFirstChild("config")
        return config ~= nil and config:FindFirstChild("dinosaur-stats") ~= nil
    end)
    if ok and isJurassic then return 1 end
    local okInfo, info = pcall(function()
        return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
    end)
    local name = okInfo and info and string.lower(tostring(info.Name)) or ""
    for n, list in ipairs({PART_1, PART_2}) do
        for _, gameName in ipairs(list) do
            if string.find(name, string.lower(gameName), 1, true) then return n end
        end
    end
    if string.find(name, "jurassic", 1, true) then return 1 end
    return nil
end

local part = pickPart()
if part == 1 then
    loadstring(game:HttpGet("https://flowauth.net/v1/loaders/Strawberry1.lua"))()
elseif part == 2 then
    loadstring(game:HttpGet("https://flowauth.net/v1/loaders/Strawberry2.lua"))()
else
    notify("This game isn't supported yet. Discord: " .. DISCORD)
end
