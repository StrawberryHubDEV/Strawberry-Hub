local genv = (getgenv and getgenv()) or _G

local function notify(text)
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", {
			Title = "Strawberry Hub",
			Text = text,
			Duration = 8,
		})
	end)
end

if genv.StrawberryLoaderRunning and os.clock() - genv.StrawberryLoaderRunning < 20 then
	return
end
genv.StrawberryLoaderRunning = os.clock()

local PART_URL = {
	[1] = "https://flowauth.net/v1/loaders/Strawberry1.lua",
	[2] = "https://flowauth.net/v1/loaders/Strawberry2.lua",
	[3] = "https://flowauth.net/v1/loaders/Strawberry3.lua",
	[4] = "https://flowauth.net/v1/loaders/Strawberry4.lua",
}

local PLACES = {
	[10696301650] = 1,
