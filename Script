local genv = (getgenv and getgenv()) or _G
if genv.StrawberryLoaderRunning then return end
genv.StrawberryLoaderRunning = true

local PART_1 = "https://flowauth.net/v1/loaders/Strawberry1.lua"
local PART_2 = "https://flowauth.net/v1/loaders/Strawberry2.lua"

local PLACES = {
	[10696301650] = 1, [122446657157717] = 1, [90165746516953] = 1, [70650894743738] = 1,
	[105527962898452] = 1, [11653088948] = 1, [108901361810209] = 1, [107088339391423] = 1,
	[107103871057311] = 1, [104067066727140] = 1,
	[142823291] = 2, [108379405712368] = 2, [94278659624110] = 2, [6686932749] = 2,
	[105667060450408] = 2, [5233782396] = 2,
}

local GAMES = {
	[129437813830973] = 1, [9534705677] = 1, [10769957062] = 1, [10769857262] = 1,
	[4130569984] = 1, [7174773198] = 1, [3873871110] = 1, [10771881861] = 1,
	[66654135] = 2, [5591327764] = 2, [10769543742] = 2, [2520686564] = 2,
	[7396714471] = 2, [1831550657] = 2,
}

local NAMES_2 = {"murder mystery", "sanctuary", "backseat rally", "prehistoria", "jurassic pixel", "creatures of sonaria"}

local function detect()
	local part = PLACES[game.PlaceId] or GAMES[game.GameId]
	if part then return part end
	local ok, info = pcall(function()
		return game:GetService("MarketplaceService"):GetProductInfoAsync(game.PlaceId)
	end)
	if not ok or not info then return nil end
	local name = string.lower(tostring(info.Name))
	for _, k in ipairs(NAMES_2) do
		if string.find(name, k, 1, true) then return 2 end
	end
	return nil
end

if not game:IsLoaded() then game.Loaded:Wait() end

local part = detect()
local tries = 0
while not part and tries < 5 do
	task.wait(1)
	tries += 1
	part = detect()
end

local ok, err = pcall(function()
	loadstring(game:HttpGet(part == 2 and PART_2 or PART_1))()
end)
genv.StrawberryLoaderRunning = nil
if not ok then warn("[Strawberry Hub] " .. tostring(err)) end
