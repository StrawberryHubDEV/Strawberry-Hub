local genv = (getgenv and getgenv()) or _G

local function notify(text)
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", {
			Title = "Strawberry Hub",
			Text = text,
			Duration = 8,
		})
	end)
end

if genv.StrawberryLoaderRunning and os.clock() - genv.StrawberryLoaderRunning < 20 then
	return
end
genv.StrawberryLoaderRunning = os.clock()

-- one part per game
local PART_URL = {}
for i = 1, 14 do
	PART_URL[i] = "https://flowauth.net/v1/loaders/Strawberry" .. i .. ".lua"
end

local PLACES = {
	[122446657157717] = 1, -- Sniper Arena
	[90165746516953] = 1, -- Sniper Arena
	[108379405712368] = 2, -- The Sanctuary
	[107088339391423] = 3, -- Degrade
	[107103871057311] = 3, -- Degrade
	[6686932749] = 4, -- Prehistoria
	[105527962898452] = 5, -- Home Defense
	[108901361810209] = 6, -- FERAL
	[10696301650] = 7, -- Primeval Earth
	[5233782396] = 8, -- Creatures of Sonaria
	[94278659624110] = 9, -- Backseat Rally
	[11653088948] = 10, -- Jurassic Blocky
	[70650894743738] = 11, -- Bug Evolution
	[104067066727140] = 12, -- Vox Seas
	[105667060450408] = 13, -- Jurassic Pixel
	[142823291] = 14, -- Murder Mystery 2
}

local GAMES = {
	[9534705677] = 1, -- Sniper Arena
	[5591327764] = 2, -- The Sanctuary
	[129437813830973] = 3, -- Degrade
	[2520686564] = 4, -- Prehistoria
	[10769857262] = 5, -- Home Defense
	[10771881861] = 6, -- FERAL
	[3873871110] = 7, -- Primeval Earth
	[1831550657] = 8, -- Creatures of Sonaria
	[10769543742] = 9, -- Backseat Rally
	[4130569984] = 10, -- Jurassic Blocky
	[10769957062] = 11, -- Bug Evolution
	[7174773198] = 12, -- Vox Seas
	[7396714471] = 13, -- Jurassic Pixel
	[66654135] = 14, -- Murder Mystery 2
}

-- most specific keywords first (so "jurassic pixel" isn't caught by "jurassic")
local NAMES = {
	{"murder mystery 2", 14},
	{"jurassic pixel", 13},
	{"creatures of sonaria", 8},
	{"backseat rally", 9},
	{"home defense", 5},
	{"bug evolution", 11},
	{"sniper arena", 1},
	{"vox seas", 12},
	{"primeval", 7},
	{"sanctuary", 2},
	{"prehistoria", 4},
	{"murder mystery", 14},
	{"feral", 6},
	{"degrade", 3},
	{"jurassic", 10},
}

local function detect()
	local part = PLACES[game.PlaceId] or GAMES[game.GameId]
	if part then return part end
	for _, id in ipairs({game.PlaceId, game.GameId}) do
		local ok, info = pcall(function()
			return game:GetService("MarketplaceService"):GetProductInfoAsync(id)
		end)
		if ok and info and info.Name then
			local name = string.lower(tostring(info.Name))
			for _, e in ipairs(NAMES) do
				if string.find(name, e[1], 1, true) then return e[2] end
			end
		end
	end
	return nil
end

if not game:IsLoaded() then game.Loaded:Wait() end

local part = detect()
local tries = 0
while not part and tries < 5 do
	task.wait(1)
	tries += 1
	part = detect()
end

-- if we can't tell, try part 1; it will hand off to the right part on its own
local url = PART_URL[part] or PART_URL[1]

local okFetch, source = pcall(function()
	return game:HttpGet(url)
end)
if not okFetch or type(source) ~= "string" or #source < 50 then
	genv.StrawberryLoaderRunning = nil
	notify("Couldn't reach the key server. Check your internet or try again.")
	return warn("[Strawberry Hub] fetch failed: " .. tostring(source))
end

local chunk, compileErr = loadstring(source)
if not chunk then
	genv.StrawberryLoaderRunning = nil
	notify("Script failed to load. Try executing again.")
	return warn("[Strawberry Hub] compile failed: " .. tostring(compileErr))
end

task.delay(15, function()
	genv.StrawberryLoaderRunning = nil
end)

local ok, err = pcall(chunk)
genv.StrawberryLoaderRunning = nil
if not ok then
	notify("Error: " .. tostring(err))
	warn("[Strawberry Hub] " .. tostring(err))
end
