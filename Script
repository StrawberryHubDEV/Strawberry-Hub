    {"sniper arena", SNIPER}, {"bug evolution", BUGEVO}, {"home defense", HOMEDEF}, {"primeval", PRIMEVAL},
    {"murder mystery", MM2}, {"sanctuary", SANCTUARY}, {"backseat rally", BACKSEAT}, {"prehistoria", PREHISTORIA},
