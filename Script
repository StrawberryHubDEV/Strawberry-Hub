if not game:IsLoaded() then
    game.Loaded:Wait()
end

local LOADERS = {
    "https://flowauth.net/v1/loaders/Strawberry1.lua",
    "https://flowauth.net/v1/loaders/Strawberry2.lua",
}

local PART_1 = {"Sniper Arena", "Bug Evolution", "Home Defense", "Jurassic Blocky", "Primeval", "FERAL", "Degrade"}
local PART_2 = {"Murder Mystery", "The Sanctuary", "Backseat Rally", "Prehistoria", "Jurassic Pixel", "Creatures of Sonaria"}

local PLACES = {
    [122446657157717] = 1, [90165746516953] = 1, [70650894743738] = 1, [105527962898452] = 1,
    [11653088948] = 1, [10696301650] = 1, [108901361810209] = 1, [107088339391423] = 1,
    [129437813830973] = 1,
    [142823291] = 2, [108379405712368] = 2, [94278659624110] = 2, [6686932749] = 2,
    [105667060450408] = 2, [5233782396] = 2,
}

local GAMES = {
    [9534705677] = 1, [10769957062] = 1, [10769857262] = 1, [4130569984] = 1,
    [5591327764] = 2, [10769543742] = 2, [7396714471] = 2, [1831550657] = 2,
}

local function fetch(url)
    local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request
    if httpRequest then
        local ok, res = pcall(httpRequest, {Url = url, Method = "GET"})
        if ok and res and res.StatusCode == 200 then return res.Body end
    end
    return game:HttpGet(url)
end

local function pickPart()
    local part = PLACES[game.PlaceId] or GAMES[game.GameId]
    if part then return part end
    local ok, isJurassic = pcall(function()
        local ts = game:GetService("ReplicatedStorage"):FindFirstChild("TS")
        local config = ts and ts:FindFirstChild("config")
        return config ~= nil and config:FindFirstChild("dinosaur-stats") ~= nil
    end)
    if ok and isJurassic then return 1 end
    local okInfo, info = pcall(function()
        return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
    end)
    local name = okInfo and info and string.lower(tostring(info.Name)) or ""
    -- part 2 first so "jurassic pixel" isn't caught by the generic jurassic fallback
    for _, n in ipairs({2, 1}) do
        for _, gameName in ipairs(n == 1 and PART_1 or PART_2) do
            if string.find(name, string.lower(gameName), 1, true) then return n end
        end
    end
    if string.find(name, "jurassic", 1, true) then return 1 end
    return nil
end

-- only one load per session, even if the loader runs twice
local g = (getgenv and getgenv()) or _G
if g.StrawberryLoaderRunning then return end
g.StrawberryLoaderRunning = true

-- the game can still be loading: retry for a few seconds
local part = pickPart()
local tries = 0
while not part and tries < 10 do
    task.wait(1)
    tries += 1
    part = pickPart()
end

-- unsupported games still open the key system, which says the game isn't supported
local ok, err = pcall(function()
    loadstring(fetch(LOADERS[part or 1]))()
end)
g.StrawberryLoaderRunning = nil
if not ok then
    warn("[Strawberry Hub] " .. tostring(err))
end
